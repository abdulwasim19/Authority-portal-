# Base URL of M3's backend. Confirm exact path/version with M3 (e.g. /api/v1).
VITE_API_BASE_URL=http://localhost:4000/api/v1

# When true, apiClient serves data from mocks/ instead of calling the
# real backend. Flip to false once M3's endpoints are ready and the
# contract below is confirmed.
VITE_USE_MOCKS=true
